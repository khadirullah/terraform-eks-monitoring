# ──────────────────────────────────────────────
# Example Variable Values
# Copy this file to terraform.tfvars and update
# ──────────────────────────────────────────────

aws_region   = "ap-south-1"
environment  = "dev"
project_name = "eks-monitoring"

# VPC
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["ap-south-1a", "ap-south-1b"]
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24"]

# EKS
# Standard support currently covers 1.34, 1.35 and 1.36. Anything older is only
# available under extended support, which this cluster opts out of in eks.tf.
cluster_version     = "1.35"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 4
node_disk_size      = 20

# Who can reach the public API server endpoint.
# The default is 0.0.0.0/0, which means the whole internet can hit it. Replace the
# line below with your own public IP as a /32 before you apply. Find it with
# `curl -s https://checkip.amazonaws.com`.
# public_access_cidrs = ["203.0.113.7/32"]
